{
	"FileVersion": 3,
	"Version": 6,
	"VersionName": "0.6.0",
	"FriendlyName": "AI Widget Inspector",
	"Description": "Click any Slate or UMG widget in the Unreal Editor to select it, trace it back to the UWidget, UserWidget, Widget Blueprint or C++ source that created it, and hand that context to an AI assistant.",
	"Category": "Editor Tools",
	"CreatedBy": "Junghyeon0710",
	"CreatedByURL": "https://github.com/Junghyeon0710",
	"DocsURL": "https://github.com/Junghyeon0710/AIWidgetInspector#readme",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/Junghyeon0710/AIWidgetInspector/issues",
	"EngineVersion": "5.8.0",
	"CanContainContent": true,
	"IsBetaVersion": true,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "AIWidgetInspector",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"PlatformAllowList": [
				"Win64",
				"Mac",
				"Linux"
			]
		}
	],
	"Plugins": [
		{
			"Name": "ToolsetRegistry",
			"Enabled": true,
			"Optional": true,
			"Description": "Needed only to let an AI assistant change widgets directly. Everything else works without it."
		},
		{
			"Name": "ModelContextProtocol",
			"Enabled": true,
			"Optional": true,
			"Description": "Hosts the MCP server an AI CLI connects to. Without it, changes still work by pasting the assistant's JSON reply."
		},
		{
			"Name": "Terminal",
			"Enabled": true,
			"Optional": true,
			"Description": "Runs the AI CLI inside the panel, so you can answer its permission prompts. Without it, the one-shot providers still work."
		}
	]
}
